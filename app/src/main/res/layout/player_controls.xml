<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <View android:id="@id/exo_controls_background" android:layout_width="0dp" android:layout_height="0dp" android:background="#20000000"/>
    <LinearLayout android:id="@id/exo_center_controls" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center">
        <ImageButton android:id="@id/exo_rew" android:layout_width="48dp" android:layout_height="48dp" android:padding="10dp" android:background="@android:color/transparent" android:src="@drawable/ic_replay" android:tint="#FFFFFF" android:contentDescription="Back 10 seconds"/>
        <ImageButton android:layout_marginHorizontal="20dp" android:id="@id/exo_play_pause" android:layout_width="88dp" android:layout_height="88dp" android:padding="20dp" android:background="@android:color/transparent" android:tint="#FFFFFF" android:scaleType="fitCenter" android:contentDescription="Play"/>
        <ImageButton android:id="@id/exo_ffwd" android:layout_width="48dp" android:layout_height="48dp" android:padding="10dp" android:background="@android:color/transparent" android:src="@drawable/ic_forward" android:tint="#FFFFFF" android:contentDescription="Forward 10 seconds"/>
    </LinearLayout>
    <LinearLayout android:id="@id/exo_bottom_bar" android:layout_width="match_parent" android:layout_height="88dp" android:layout_gravity="bottom" android:paddingHorizontal="16dp" android:paddingBottom="8dp" android:gravity="bottom" android:orientation="vertical" android:background="@drawable/player_bar">
        <LinearLayout android:id="@+id/player_time_row" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@id/exo_position" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="13sp"/>
            <TextView android:id="@id/exo_duration" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center_vertical" android:textColor="#FFFFFF" android:textSize="13sp"/>
            <ImageButton android:id="@+id/player_fullscreen" android:layout_width="48dp" android:layout_height="48dp" android:background="@android:color/transparent" android:padding="12dp" android:src="@drawable/ic_fullscreen" android:tint="#FFFFFF" android:contentDescription="Fullscreen"/>
        </LinearLayout>

    </LinearLayout>
<androidx.media3.ui.DefaultTimeBar android:id="@id/exo_progress" android:layout_width="match_parent" android:layout_height="40dp" android:layout_gravity="bottom" android:layout_marginBottom="48dp" android:paddingHorizontal="16dp" app:played_color="#DCE8E1" app:scrubber_color="#DCE8E1" app:buffered_color="#80FFFFFF" app:unplayed_color="#40FFFFFF"/>
</merge>

